{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "gstack",
  "version": "0.1.0",
  "description": "gstack is a set of rigorous agent workflows, forked from pstack.",
  "author": {
    "name": "gregogun"
  },
  "license": "MIT",
  "keywords": [
    "gstack",
    "go-mode",
    "workflow",
    "principles",
    "agent-style",
    "subagents",
    "unslop"
  ],
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/chat-mode/scripts/mode-guard.mjs\"" }] }
    ],
    "PreToolUse": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/chat-mode/scripts/mode-guard.mjs\"" }] }
    ]
  }
}
